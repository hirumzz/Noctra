// NOCTRA Windows Native Executable Resource Manifest (Icon + Publisher Metadata)
1 ICON "assets/noctra.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NOCTA Ecosystem"
            VALUE "FileDescription", "NOCTRA Desktop Web Browser — Beyond Browsing."
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "noctra.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026 NOCTA Ecosystem. All rights reserved."
            VALUE "OriginalFilename", "noctra.exe"
            VALUE "ProductName", "NOCTRA Desktop Browser"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
